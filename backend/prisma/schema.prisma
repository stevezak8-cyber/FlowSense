// FlowSense - HVAC business operating system
// MVP: Technician co-pilot, job docs, pre-arrival intel, compliance
//
// DATABASE WORKFLOW:
//   Development:  npm run db:migrate      (creates migration files + applies)
//   Production:   npm run db:migrate:deploy (applies existing migrations, no prompts)
//   Prototyping:  npm run db:push         (schema push, no migration files — DEV ONLY)
//
// IMPORTANT: Always use db:migrate in dev to generate tracked migration files.
// Never use db:push against a production database — it can cause data loss.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Organizations (HVAC companies, 1–5 trucks for MVP)
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  email     String?
  address   String?
  notificationPreferences Json? // { booking: bool, statusChange: bool, completion: bool, urgent: bool }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stripeCustomerId      String?
  stripeSubscriptionId  String?
  plan                  String    @default("trial")
  trialEndsAt           DateTime?
  onboardingDismissed   Boolean   @default(false)
  stripeConnectAccountId  String?
  stripeConnectOnboarded  Boolean @default(false)
  smsEnabled              Boolean @default(false)

  users         User[]
  technicians   Technician[]
  customers     Customer[]
  jobs          Job[]
  vehicles      Vehicle[]
  invoices      Invoice[]
  conversations Conversation[]

  estimateDepositThreshold Float  @default(500)
  estimateDepositPercent   Int    @default(25)
  pricebookItems           PricebookItem[]
  estimates                Estimate[]
  pushSubscriptions        PushSubscription[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  passwordHash   String       @default("")
  role           String       @default("office") // office | technician | customer
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String?      @unique
  customer       Customer?    @relation(fields: [customerId], references: [id])
  technicianId   String?      @unique
  technician     Technician?  @relation(fields: [technicianId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  pushSubscriptions PushSubscription[]

  @@index([organizationId])
}

// Field technicians
model Technician {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  epa608Level    String?      // EPA 608 compliance level
  skills         String[]     @default([])  // e.g. ["furnace", "ac", "heat-pump"]
  isOnDuty       Boolean      @default(true)  // live availability toggle
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jobs    Job[]
  vehicle Vehicle?
  user    User?

  @@index([organizationId])
}

model Vehicle {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       // e.g. "Truck 1"
  technicianId   String?      @unique
  technician     Technician?  @relation(fields: [technicianId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

// Customers (property / contact)
model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String
  address        String
  smsOptOut      Boolean  @default(false)
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jobs     Job[]
  invoices Invoice[]
  user     User?

  @@index([organizationId])
}

model PushSubscription {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  endpoint       String       @unique
  p256dh         String
  auth           String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

// Service jobs (MVP core)
model Job {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technicianId   String?
  technician     Technician?  @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  status         String       @default("pending") // pending | scheduled | en_route | in_progress | completed | cancelled
  priority       String       @default("normal")   // low | normal | high | urgent
  scheduledAt    DateTime
  symptomSummary String?      // AI intake summary
  equipmentType  String?      // furnace, ac, heat-pump, etc.
  equipmentNotes String?
  serviceType    String?      // repair | maintenance | inspection | installation

  // Pre-arrival intelligence (populated for technician)
  preArrivalNotes String?
  suggestedParts  String[]    @default([])
  suggestedTools  String[]    @default([])
  riskFlags       String[]    @default([])

  // Documentation (auto + voice-to-report)
  summary         String?
  actionsTaken    String?
  partsUsed       String[]    @default([])
  photos          String[]    @default([])  // URLs after upload
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  complianceLogs ComplianceLog[]
  invoices       Invoice[]
  estimates      Estimate[]
  aiMessages     AiMessage[]

  @@index([organizationId])
  @@index([technicianId])
  @@index([customerId])
  @@index([status])
  @@index([scheduledAt])
}

// Invoices tied to jobs
model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  description    String
  amount         Float
  status         String       @default("pending") // pending | paid | overdue
  issuedDate     DateTime     @default(now())
  dueDate        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([jobId])
  @@index([customerId])
  @@index([status])
}

model PricebookItem {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  category       String
  unit           String?
  unitPrice      Float
  locked         Boolean  @default(false)
  source         String   @default("admin")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines          EstimateLine[]

  @@index([organizationId])
}

model Estimate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  token          String   @unique @default(cuid())
  status         String   @default("draft")
  selectedTier   String?
  signatureData  String?
  signedAt       DateTime?
  depositAmount  Float?
  depositPaidAt  DateTime?
  stripePaymentIntentId String?
  sentAt         DateTime?
  approvedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines          EstimateLine[]

  @@index([jobId])
  @@index([organizationId])
  @@index([token])
}

model EstimateLine {
  id              String   @id @default(cuid())
  estimateId      String
  estimate        Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  pricebookItemId String?
  pricebookItem   PricebookItem? @relation(fields: [pricebookItemId], references: [id])
  tier            String
  name            String
  quantity        Float    @default(1)
  unitPrice       Float
  locked          Boolean  @default(false)
  source          String   @default("manual")
}

// Conversations & messages
model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject        String
  channel        String       @default("internal") // internal | sms | email | phone
  participants   String[]     @default([])
  unreadCount    Int          @default(0)
  lastMessageAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages Message[]

  @@index([organizationId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String
  senderRole     String       @default("dispatch") // dispatch | technician | customer | system
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model AiMessage {
  id        String   @id @default(cuid())
  jobId     String
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// Compliance & audit trail (EPA 608, safety, timestamps)
model ComplianceLog {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type      String   // epa608_prompt | safety_ack | code_reminder | photo_audit | ai_disclaimer
  payload   Json     // type-specific data
  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([type])
}
