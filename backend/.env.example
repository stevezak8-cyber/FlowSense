# ── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/flowsense?schema=public"

# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" in prod — enables static frontend serving and disables
# the dev-only JSON root response.
NODE_ENV=development

# ── CORS (development only) ───────────────────────────────────────────────────
# In production with NODE_ENV=production, the frontend is served by Express
# directly so CORS isn't needed. In dev, Vite proxies API calls so this
# should match your Vite dev server URL.
FRONTEND_URL="http://localhost:5173"

# ── Email (optional) ──────────────────────────────────────────────────────────
# Emails are silently skipped if RESEND_API_KEY is not set.
# Sign up at https://resend.com — free tier covers 3,000 emails/month.
RESEND_API_KEY=

# Sender address — requires a verified domain in Resend.
# e.g. "FlowSense <noreply@yourdomain.com>"
FROM_EMAIL=

# ── AI features (optional) ────────────────────────────────────────────────────
# Enables pre-arrival briefings and job completion AI summaries.
# Silently skipped if not set.
ANTHROPIC_API_KEY=

# ── Google Maps (optional) ────────────────────────────────────────────────────
# Enables drive-time estimates in smart dispatch suggestions.
# Without this, dispatch falls back to skill/availability ranking only.
GOOGLE_MAPS_API_KEY=

# ── Stripe (optional) ─────────────────────────────────────────────────────────
# Enables online invoice payments via Stripe Checkout.
# Get your secret key at https://dashboard.stripe.com/apikeys
# Use sk_test_... for testing, sk_live_... for production.
STRIPE_SECRET_KEY=

# Webhook signing secret — get this from Stripe Dashboard → Webhooks → your endpoint.
# For local dev, use the Stripe CLI: stripe listen --forward-to localhost:4000/webhooks/stripe
# The CLI prints a webhook signing secret (whsec_...) — paste it here.
# If not set, signature verification is skipped (dev only).
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SHOP=price_...
STRIPE_PRICE_ID_FLEET=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...

# Public URL of your app — used to build Stripe success/cancel redirect URLs.
# In production on Railway this is typically https://yourapp.up.railway.app
APP_URL=http://localhost:5173

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
